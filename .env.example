# ==============================================================================
# Py-Agent Provider Configuration (.env)
# Priority: Top-Down (First Active / Un-commented Key is Used)
# ==============================================================================

# --- Google Gemini ---
# GEMINI_API_KEY="AIzaSyYourGeminiKeyHere"
# GEMINI_MODEL="gemini-3.5-flash-lite"

# --- OpenRouter ---
# OPENROUTER_API_KEY="sk-or-v1-YourOpenRouterKeyHere"
# OPENROUTER_MODEL="openrouter/free"

# --- OpenAI ---
# OPENAI_API_KEY="sk-proj-YourOpenAIKeyHere"
# OPENAI_MODEL="gpt-5.6"

# --- Anthropic Claude ---
# CLAUDE_API_KEY="sk-ant-YourClaudeKeyHere"
# CLAUDE_MODEL="claude-opus-5"

# --- xAI Grok ---
# XAI_API_KEY="xai-YourGrokKeyHere"
# XAI_MODEL="grok-4.6"

# --- Context Limit ---
AI_MAX_TOKENS="8192"
