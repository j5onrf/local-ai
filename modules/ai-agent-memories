#!/usr/bin/env python3
# Description: SQLite-backed semantic recall and Temporal Personality Memory (TPM) manager
import sys, os, json, sqlite3, time, re
from contextlib import closing
from typing import List

CFG_DIR: str = os.path.expanduser("~/.config/local-ai")
SESSIONS_DIR: str = os.path.join(CFG_DIR, "projects", "database")
sys.path.append(os.path.join(CFG_DIR, "modules"))
try:
    from agent_context import tokenize, STOP_WORDS
except ImportError:
    TOKEN_RE = re.compile(r"[^\w\s]")
    STOP_WORDS = {"is", "what", "it", "do", "any", "i", "have", "the", "a", "an", "on", "to", "for", "me", "you", "my", "your", "we", "us", "are", "about", "in", "how"}
    def tokenize(text: str) -> List[str]:
        return [w for w in TOKEN_RE.sub(" ", text.lower()).split() if len(w) > 1 and w not in STOP_WORDS] if text else []


try:
    import agent_ui as ui
    get_key = ui.get_key
except ImportError:
    def get_key() -> str:
        import tty, termios, select
        fd = sys.stdin.fileno()
        try: old = termios.tcgetattr(fd)
        except Exception: return sys.stdin.read(1)
        try:
            tty.setraw(fd)
            r = os.read(fd, 1)
            if r == b'\x1b' and select.select([fd], [], [], 0.05)[0]: r += os.read(fd, 2)
            return r.decode("utf-8", errors="ignore")
        finally: termios.tcsetattr(fd, termios.TCSADRAIN, old)


def connect_db(db_path: str) -> sqlite3.Connection:
    """Wrapper to generate WAL-enabled concurrent SQLite connections with self-healing table creation."""
    os.makedirs(os.path.dirname(db_path), exist_ok=True)
    conn = sqlite3.connect(db_path, timeout=30.0)
    try:
        conn.execute("PRAGMA journal_mode=WAL;")
        conn.execute("PRAGMA busy_timeout = 5000;")
        conn.execute("CREATE TABLE IF NOT EXISTS tpm_memories (key TEXT PRIMARY KEY, value TEXT, timestamp INTEGER);")
        conn.commit()
    except Exception: pass
    return conn


def search_past_context(workspace: str, query: str) -> None:
    """Semantic Recall: Searches and injects highly relevant past conversation turns."""
    if not (q_tokens := set(tokenize(query))) or not os.path.exists(db_path := os.path.join(SESSIONS_DIR, f"{workspace}.db")): return
    with closing(connect_db(db_path)) as conn:
        try: rows = conn.cursor().execute("SELECT user_msg, assistant_msg, tokens, timestamp FROM turns WHERE workspace = ?", (workspace,)).fetchall()
        except sqlite3.OperationalError: return

    candidates = []
    for user_msg, assistant_msg, tokens, ts in rows:
        t_tokens = set(tokens.split())
        if (score := len(q_tokens & t_tokens) / len(q_tokens | t_tokens) if (q_tokens & t_tokens) else 0.0) >= 0.35:
            candidates.append((score, user_msg, assistant_msg, ts))

    if not candidates: return
    candidates.sort(key=lambda x: -x[0])
    num_opts, current_idx = len(candidates), 0
    sys.stderr.write("\033[?25l"); sys.stderr.flush()

    try:
        while True:
            _, user_msg, assistant_msg, ts = candidates[current_idx]
            idx_str = f"[{current_idx + 1:02d}/{num_opts:02d}] ❯ " if num_opts > 1 else ""
            disp = user_msg.strip().replace("\n", " ")
            date_str = time.strftime('%Y-%m-%d %H:%M', time.localtime(ts))
            sys.stderr.write(f"\r\x1b[K\033[2m{idx_str}[memory] ({date_str})\033[0m\n\r\x1b[K\033[3m   \"{disp[:47] + '...' if len(disp) > 40 else disp}\"\033[0m [↵ load  d: disable  Esc/Arrows: skip]: ")
            sys.stderr.flush()

            key = get_key()
            sys.stderr.write("\r\x1b[K\x1b[1A\r\x1b[K"); sys.stderr.flush()

            if key == '\x03':
                sys.stderr.write("Cancelled.\n"); sys.exit(2)
            elif key in ('\r', '\n'):
                sys.stderr.write("\033[2;32m[sys] Memory injected.\033[0m\n"); sys.stderr.flush()
                print(f"\n### Relevant Past Discussion (Retrieved from Session Memory):\n* **On {date_str} you asked**: \"{user_msg}\"\n  **Agent responded**: \"{assistant_msg.strip()}\"")
                break
            elif key in ('d', 'D'):
                sys.stderr.write("\033[2;31m[sys] Memory recall disabled. (Type /m to re-enable)\033[0m\n"); sys.stderr.flush(); sys.exit(3)
            elif key in ('\x1b[A', '\x1b[B'):
                current_idx = (current_idx + (1 if key == '\x1b[B' else -1) + num_opts) % num_opts
            else:
                sys.stderr.write("\033[2;31m[sys] Memory recall skipped.\033[0m\n"); sys.stderr.flush(); sys.exit(0)
    finally: sys.stderr.write("\033[?25h"); sys.stderr.flush()


def tpm_reconcile(workspace: str) -> None:
    """Overwrites or inserts up-to-date facts into SQLite."""
    try: parsed = json.loads(sys.stdin.read().strip())
    except Exception: sys.exit(1)
    if not parsed or not isinstance(parsed, dict): sys.exit(0)

    with closing(connect_db(os.path.join(SESSIONS_DIR, f"{workspace}.db"))) as conn:
        cur, now = conn.cursor(), int(time.time())
        for k, v in parsed.items():
            k_clean, v_clean = str(k).strip().lower(), str(v).strip()
            if not v_clean or v_clean.lower() in ("none", "null", "removed", "deleted"):
                cur.execute("DELETE FROM tpm_memories WHERE key = ?", (k_clean,))
            else:
                cur.execute("INSERT OR REPLACE INTO tpm_memories (key, value, timestamp) VALUES (?, ?, ?)", (k_clean, v_clean, now))
        conn.commit()


def tpm_get(workspace: str) -> None:
    """Reads compiled facts from SQLite and outputs a structured Markdown block."""
    db_path = os.path.join(SESSIONS_DIR, f"{workspace}.db")
    if os.path.exists(db_path):
        try:
            with closing(connect_db(db_path)) as conn:
                if rows := conn.cursor().execute("SELECT key, value FROM tpm_memories ORDER BY key").fetchall():
                    print("### TEMPORAL PERSONALITY MEMORY (TPM):\nThe following are compiled, up-to-date facts and style preferences about the user:\n" + "\n".join(f"* **{k}**: {v}" for k, v in rows) + "\n")
        except Exception: pass


def tpm_clear(workspace: str) -> None:
    """Wipes all compiled facts from the tpm_memories table."""
    db_path = os.path.join(SESSIONS_DIR, f"{workspace}.db")
    if os.path.exists(db_path):
        with closing(connect_db(db_path)) as conn:
            conn.cursor().execute("DELETE FROM tpm_memories")
            conn.commit()


def get_tpm_count(workspace: str) -> None:
    """Outputs the count of active compiled facts in the database."""
    db_path = os.path.join(SESSIONS_DIR, f"{workspace}.db")
    if os.path.exists(db_path):
        try:
            with closing(connect_db(db_path)) as conn:
                print(conn.cursor().execute("SELECT COUNT(*) FROM tpm_memories").fetchone()[0])
        except Exception: print(0)
    else: print(0)


if __name__ == "__main__":
    if len(args := sys.argv[1:]) >= 2:
        cmd, ws = args[0], args[1]
        if cmd == "get-context": search_past_context(ws, args[2] if len(args) > 2 else "")
        elif cmd == "tpm-reconcile": tpm_reconcile(ws)
        elif cmd == "tpm-get": tpm_get(ws)
        elif cmd == "tpm-clear": tpm_clear(ws)
        elif cmd == "get-tpm-count": get_tpm_count(ws)
