#!/usr/bin/env python3
"""Plugins - High-Speed Markdown-Native Plugin & Shortcut Map Generator"""

import os, sys, re

CONTEXT_FILE = os.path.expanduser("~/.config/local-ai/ai-context.md")

if not os.path.exists(CONTEXT_FILE):
    sys.stderr.write(f"❌ Error: Context file not found at {CONTEXT_FILE}\n")
    sys.exit(1)

SECTION_RE = re.compile(r"^##\s*(\d+)\.\s*(.+)$")
URL_RE = re.compile(r"(https?://\S+)")

print("# PLUGINS\nActive plugin mappings, system tools, and shell shortcuts.\n")

try:
    with open(CONTEXT_FILE, "r", encoding="utf-8") as f:
        lines = f.readlines()
except OSError as e:
    sys.stderr.write(f"❌ Error reading file: {e}\n")
    sys.exit(1)

in_code_block = False
table_open = False

for line in lines:
    s = line.strip()
    if s.startswith("```"):
        in_code_block = not in_code_block
        continue

    if m := SECTION_RE.match(s):
        if table_open:
            print()
            table_open = False
        print(f"## {m.group(1)}. {m.group(2)}\n\n| Plugin / Trigger | Target Command |\n| :--- | :--- |")
        table_open = True
        continue

    if not in_code_block or s.startswith("#") or "--->" not in s:
        continue

    cmd, intents = s.split("--->", 1)
    cmd = cmd.replace("[TOOL]", "").strip()

    intent_list = [i.strip() for i in intents.split(",") if i.strip()]
    shortcut_display = " / ".join(f"`{x}`" for x in intent_list[:3])

    if url_match := URL_RE.search(cmd):
        cleaned_cmd = url_match.group(1).replace('"', '').replace("'", "")
    else:
        cleaned_cmd = " ".join(os.path.basename(w) if w.startswith(('/', '~', './', '../')) else w for w in cmd.split())

    print(f"| {shortcut_display} | {cleaned_cmd.replace('|', r'\|')} |")

print()
