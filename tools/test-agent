#!/usr/bin/env python3
"""Unified All-in-One Local-AI Diagnostic & Live Functional Suite"""

import sys, os, shutil, tempfile, json, subprocess, importlib, py_compile

CFG_DIR = os.path.expanduser("~/.config/local-ai")
sys.path.insert(0, os.path.join(CFG_DIR, "modules"))
sys.path.insert(0, CFG_DIR)

GREEN, RED, CYAN, YELLOW, RESET = "\033[1;32m", "\033[1;31m", "\033[1;36m", "\033[1;33m", "\033[0m"

def print_result(name: str, passed: bool, detail: str = ""):
    if passed:
        print(f"  {GREEN}✔ PASS{RESET} : {name:<46} {GREEN}{detail}{RESET}")
    else:
        print(f"  {RED}✖ FAIL{RESET} : {name:<46} {RED}{detail}{RESET}")

print(f"\n{CYAN}======================================================================{RESET}")
print(f"{CYAN}           LOCAL-AI ALL-IN-ONE DIAGNOSTIC & SANITY SUITE              {RESET}")
print(f"{CYAN}======================================================================{RESET}\n")

all_passed = True

# --- PASS 1: GRANULAR BYTECODE COMPILATION (20 FILES) ---
print(f"{CYAN}[Pass 1/8] Bytecode Compilation (Granular 20 Files){RESET}")
files_to_compile = [
    "ai-agent.py", "modules/agent_core.py", "modules/agent_ipython.py",
    "modules/agent_tools.py", "modules/agent_tui.py", "modules/agent_tui_async.py",
    "modules/agent_usage.py", "modules/agent_cloud.py", "modules/agent_context.py",
    "modules/agent_skills.py", "modules/agent_spell.py", "modules/agent_ui.py",
    "modules/agent_voice.py", "modules/agent_tts.py", "modules/model-select.py",
    "modules/speed_test.py", "modules/ai-agent-sessions", "modules/ai-agent-memories",
    "modules/chat", "tools/loop/ralph.py"
]

for f in files_to_compile:
    full_path = os.path.join(CFG_DIR, f)
    try:
        py_compile.compile(full_path, doraise=True)
        print_result(f, True)
    except Exception as e:
        print_result(f, False, str(e))
        all_passed = False

# --- PASS 2: GRANULAR MODULE IMPORTS ---
print(f"\n{CYAN}[Pass 2/8] Module Imports & Cross-Dependencies{RESET}")
modules_to_import = [
    "agent_core", "agent_ipython", "agent_tools", "agent_usage",
    "agent_cloud", "agent_context", "agent_skills", "agent_spell",
    "agent_ui", "agent_voice", "agent_tts", "speed_test"
]

for mod in modules_to_import:
    try:
        importlib.import_module(mod)
        print_result(f"import {mod}", True)
    except Exception as e:
        print_result(f"import {mod}", False, str(e))
        all_passed = False

# --- PASS 3: DATABASE SUBCOMMAND PROBES ---
print(f"\n{CYAN}[Pass 3/8] SQLite Subsystem & Subcommand Probes{RESET}")
test_ws = "test_unified_sanity_ws"
try:
    r = subprocess.run([sys.executable, os.path.join(CFG_DIR, "modules", "ai-agent-sessions"), "init", test_ws], capture_output=True, text=True, timeout=5)
    print_result("ai-agent-sessions init", r.returncode == 0)
except Exception as e:
    print_result("ai-agent-sessions init", False, str(e))
    all_passed = False

try:
    r = subprocess.run([sys.executable, os.path.join(CFG_DIR, "modules", "ai-agent-sessions"), "get-count", test_ws], capture_output=True, text=True, timeout=5)
    print_result("ai-agent-sessions get-count", r.stdout.strip().isdigit())
except Exception as e:
    print_result("ai-agent-sessions get-count", False, str(e))
    all_passed = False

try:
    r = subprocess.run([sys.executable, os.path.join(CFG_DIR, "modules", "ai-agent-memories"), "get-tpm-count", test_ws], capture_output=True, text=True, timeout=5)
    print_result("ai-agent-memories get-tpm-count", r.stdout.strip().isdigit())
except Exception as e:
    print_result("ai-agent-memories get-tpm-count", False, str(e))
    all_passed = False

# Isolated Sandbox Workspace for Functional Tests
sandbox_dir = tempfile.mkdtemp(prefix="local_ai_test_")

try:
    # --- PASS 4: STATE ENGINE & DISK CACHE ---
    print(f"\n{CYAN}[Pass 4/8] State Machine & Caching Engine{RESET}")
    import agent_core as core
    core.save_state("test_key_sanity", 99999)
    st_val = core.get_state("test_key_sanity")
    p4 = (st_val == 99999)
    print_result("State Save & Cached Read", p4, f"Read: {st_val}")
    all_passed = all_passed and p4

    # --- PASS 5: LIVE TOOL EXECUTION & AST SYNTAX GUARDS ---
    print(f"\n{CYAN}[Pass 5/8] Live Tool Execution Engine & AST Guards{RESET}")
    import agent_tools as tools

    res_w = tools.run_tool("write_file", {"path": "test_script.py", "content": "x = 42\nprint(x)\n"}, sandbox_dir)
    p5_a = "wrote" in res_w
    print_result("write_file (Valid Python)", p5_a, res_w.strip())

    res_bad = tools.run_tool("write_file", {"path": "broken.py", "content": "def broken_syntax(:\n    pass"}, sandbox_dir)
    p5_b = "[error] Write blocked" in res_bad
    print_result("write_file (AST Syntax Guard Block)", p5_b, "Blocked invalid syntax")

    res_r = tools.run_tool("read_file", {"path": "test_script.py"}, sandbox_dir)
    p5_c = "x = 42" in res_r
    print_result("read_file", p5_c, f"Length: {len(res_r)} chars")

    res_l = tools.run_tool("list_dir", {"path": "."}, sandbox_dir)
    p5_d = "test_script.py" in res_l
    print_result("list_dir", p5_d, f"Entries: {res_l.splitlines()}")

    # Run command in autonomous test mode to work through pipes
    old_gates = os.environ.get("AI_CONFIRM_GATES")
    try:
        os.environ["AI_CONFIRM_GATES"] = "0"
        res_cmd = tools.run_tool("run_command", {"command": "python3 test_script.py"}, sandbox_dir)
    finally:
        if old_gates is not None: os.environ["AI_CONFIRM_GATES"] = old_gates
        else: os.environ.pop("AI_CONFIRM_GATES", None)

    p5_e = res_cmd.strip() == "42"
    print_result("run_command (Subprocess Execution)", p5_e, f"Output: '{res_cmd.strip()}'")
    all_passed = all_passed and (p5_a and p5_b and p5_c and p5_d and p5_e)

    # --- PASS 6: IPYTHON SANDBOX KERNEL ---
    print(f"\n{CYAN}[Pass 6/8] IPython Sandbox Kernel & Variable Persistence{RESET}")
    import agent_ipython as ipython
    ipython.run_cell("a = 150\nb = 250", sandbox_dir)
    out2 = ipython.run_cell("a + b", sandbox_dir)
    p6 = "400" in out2
    print_result("IPython Cross-Cell State", p6, f"Result: {out2.strip()}")
    all_passed = all_passed and p6

    # --- PASS 7: JACCARD CONTEXT & BLUEPRINTS ---
    print(f"\n{CYAN}[Pass 7/8] Jaccard Context & Blueprint Parser{RESET}")
    import agent_context as context
    ctx_path = os.path.join(CFG_DIR, "ai-context.md")
    if os.path.exists(ctx_path):
        entries = context.load_context_entries(ctx_path)
        print_result(f"ai-context.md ({len(entries)} intent tokens)", len(entries) > 0)
        match = context.jaccard_search("get weather", ctx_path)
        p7 = match is not None and "wttr" in match
        print_result("Intent Matching Query ('get weather' -> wttr)", p7)
        all_passed = all_passed and p7
    else:
        print_result("ai-context.md exists", False, "File missing")
        all_passed = False

    # --- PASS 8: SPEND LEDGER & PRICING ---
    print(f"\n{CYAN}[Pass 8/8] Spend Ledger & Cost Engine{RESET}")
    import agent_usage as usage
    orig_ledger = usage.LEDGER_PATH
    try:
        # Isolate in sandbox to prevent recording dummy spend in real ledger
        usage.LEDGER_PATH = os.path.join(sandbox_dir, "test_ledger.json")
        usage.record("gemini", 1000000, 1000000, 0.0)
        line = usage.turn_line(1000000, 1000000, 4.50, 2000000, 8192)
        p8 = "$4.50" in line
        print_result("Dummy Test Spend Accounting", p8, f"Summary: {line.strip()}")
        all_passed = all_passed and p8
    finally:
        usage.LEDGER_PATH = orig_ledger

finally:
    shutil.rmtree(sandbox_dir, ignore_errors=True)
    # Cleanup sanity DB
    subprocess.run([sys.executable, os.path.join(CFG_DIR, "modules", "ai-agent-sessions"), "clear", test_ws], capture_output=True, timeout=5)
    db_file = os.path.join(CFG_DIR, "projects", "database", f"{test_ws}.db")
    if os.path.exists(db_file):
        try: os.remove(db_file)
        except OSError: pass

print(f"\n{CYAN}======================================================================{RESET}")
if all_passed:
    print(f"{GREEN}     ✔ ALL 8 PASSES SUCCESSFUL — LOCAL-AI STACK IS 100% OPERATIONAL     {RESET}")
else:
    print(f"{RED}     ✖ SOME TESTS FAILED — CHECK DETAILS ABOVE                         {RESET}")
print(f"{CYAN}======================================================================{RESET}\n")
