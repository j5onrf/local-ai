#!/usr/bin/env bash
# AI Update Inspector - Universal Arch Linux Edition [j5onrf]

set -euo pipefail

CFG_DIR="${HOME}/.config/py-agent"
spinner_chars=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏")
SPINNER_PID=""

start_spinner() {
    echo -ne "\033[?25l" >&2
    (
        local i=0
        while true; do
            printf "\r\033[1;32m%s\033[0m Checking for updates..." "${spinner_chars[i % 10]}" >&2
            ((i++)); sleep 0.08
        done
    ) &
    SPINNER_PID=$!
}

stop_spinner() {
    if [ -n "${SPINNER_PID:-}" ]; then
        kill "$SPINNER_PID" 2>/dev/null || true
        wait "$SPINNER_PID" 2>/dev/null || true
        SPINNER_PID=""
    fi
    echo -ne "\r\033[2K\r\033[?25h" >&2
}

trap stop_spinner EXIT

# 1. Start loading spinner
start_spinner

all_updates=""
repo_summary=""

# 2. Gather Official / Native Repository Updates
if command -v checkupdates >/dev/null 2>&1; then
    raw_repo=$(checkupdates 2>/dev/null || true)
    if [ -n "$raw_repo" ]; then
        all_updates="$raw_repo"
        pkg_names=$(echo "$raw_repo" | awk '{print $1}')
        
        # Dynamically detect and group packages by their origin repository (core, extra, multilib, cachyos, endeavouros, etc.)
        repo_info=$(pacman -Si $pkg_names 2>/dev/null | awk '/^Repository/ {repo=$3} /^Name/ {name=$3; if (!seen[name]) { print repo"|"name; seen[name]=1 } }')
        
        # Build dynamic counts per repository
        repos=$(echo "$repo_info" | cut -d'|' -f1 | sort -u)
        for r in $repos; do
            count=$(echo "$repo_info" | grep "^${r}|" | wc -l)
            pkgs=$(echo "$repo_info" | grep "^${r}|" | cut -d'|' -f2 | awk '{printf "%s\140%s\140", (NR==1?"":", "), $1} END {print ""}')
            repo_summary+=$"* **Repository \`$r\`**: \`$count\` packages\n  - Packages: $pkgs\n\n"
        done
    else
        repo_summary="* **Native Repositories**: \`0\` updates (System up to date)\n\n"
    fi
else
    repo_summary="* **Native Repositories**: *checkupdates utility missing (install pacman-contrib)*\n\n"
fi

# 3. Gather AUR Updates (Auto-detect paru / yay)
aur_helper=$(command -v paru >/dev/null && echo "paru" || { command -v yay >/dev/null && echo "yay"; } || echo "")
aur_summary=""

if [ -n "$aur_helper" ]; then
    raw_aur=$($aur_helper -Qua 2>/dev/null || true)
    if [ -n "$raw_aur" ]; then
        all_updates+=$'\n'"$raw_aur"
        aur_count=$(echo "$raw_aur" | wc -l)
        aur_pkgs=$(echo "$raw_aur" | awk '{printf "%s\140%s\140", (NR==1?"":", "), $1} END {print ""}')
        aur_summary="* **AUR ($aur_helper)**: \`$aur_count\` packages\n  - Packages: $aur_pkgs\n"
    else
        aur_summary="* **AUR ($aur_helper)**: \`0\` updates\n"
    fi
else
    aur_summary="* **AUR**: *No AUR helper (yay/paru) detected*\n"
fi

# 4. Filter Universal Spotlight Applications across all categories
# Matches browsers, editors, core system kernels, graphics drivers, desktop environments, and major tools
SPOTLIGHT_REGEX="^(brave|firefox|chromium|zen-browser|librewolf|vivaldi|google-chrome|tor-browser|zed|neovim|code|vscodium|emacs|helix|yt-dlp|linux|linux-lts|linux-zen|linux-cachyos|nvidia|mesa|pipewire|wireplumber|hyprland|waybar|sway|plasma|gnome|cosmic|systemd|glibc|archlinux-keyring|python|rust|nodejs|docker|ollama|llama)"
spotlight_raw=""
if [ -n "$all_updates" ]; then
    spotlight_raw=$(echo "$all_updates" | grep -iE "$SPOTLIGHT_REGEX" || true)
fi

# 5. Stop loading spinner
stop_spinner

# 6. Output Directives & Structured Data
SKILL_FILE="$CFG_DIR/skills/system/update-inspector.md"
if [ -f "$SKILL_FILE" ]; then
    cat "$SKILL_FILE"
    echo ""
fi

if [ -n "$spotlight_raw" ]; then
    echo "### KEY / SPOTLIGHT APPLICATION UPDATES"
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        pkg=$(echo "$line" | awk '{print $1}')
        old_v=$(echo "$line" | awk '{print $2}')
        new_v=$(echo "$line" | awk '{print $4}')
        echo "* **\`$pkg\`**: \`$old_v\` ──► \`$new_v\`"
    done <<< "$spotlight_raw"
    echo ""
fi

echo "### REPOSITORY BREAKDOWN"
echo -e "$repo_summary"
echo -e "$aur_summary"
