#!/usr/bin/env bash
# ai-commit - Automate Git Commits with AI Context

set -euo pipefail

if [[ "${BASH_SOURCE[0]}" != "${0}" ]]; then
    trap 'echo -e "\n\n👋 Commit aborted."; return 130 2>/dev/null || exit 130' INT
else
    trap 'echo -e "\n\n👋 Commit aborted."; exit 130' INT
fi

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "❌ Error: Not inside a git repository." >&2
    exit 1
fi

stats=$(git diff --cached --name-status | head -n 8 || true)
if [[ -z "$stats" ]]; then
    echo "⚠️  No staged changes found. Run 'git add' on your files first." >&2
    exit 0
fi

_AI_SCRIPT_PATH="$HOME/.config/local-ai/ai-agent.py"
_AI_PYTHON_BIN=$(command -v python3 2>/dev/null || type -p python3 2>/dev/null || echo "python3")

changes=$(git diff --cached -U0 -- \
    ':(exclude)*lock*' ':(exclude)*.svg' ':(exclude)*.png' ':(exclude)*.jpg' ':(exclude)*.gif' \
    | awk '
    /^\+[^+]/ || /^-[^-]/ {
        val = substr($0, 2)
        sub(/^[ \t]+/, "", val)
        if (val != "" && val !~ /^(#|\/\/|\/\*|\*)/) {
            print $0
            count++
            if (count >= 15) { exit }
        }
    }' || true)

PROMPT="Summarize ONLY the primary staged change as a short commit title.

Rules:
- STRICT LENGTH: Between 3 and 6 words long.
- Summarize ONLY the main primary change. Do NOT list multiple items or use semicolons.
- Start with an action verb (Add, Fix, Refactor, Update).
- Output ONLY the title text. No quotes, no period at the end.

Example: Update model reference and fix token streamer

Files:
$stats

Diff:
$changes"

tmp_out=$(mktemp)
"$_AI_PYTHON_BIN" "$_AI_SCRIPT_PATH" --talk "$PROMPT" > "$tmp_out" 2>/dev/null &
pid=$!

spin='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
i=0
while kill -0 "$pid" 2>/dev/null; do
    i=$(( (i + 1) % 10 ))
    printf "\r\033[1;32m%s\033[0m \033[36mGenerating commit message...\033[0m " "${spin:$i:1}" >&2
    sleep 0.08
done
wait "$pid" 2>/dev/null || true
printf "\r\033[2K" >&2

raw_message=$(cat "$tmp_out" 2>/dev/null || echo "")
rm -f "$tmp_out"

message=$(echo "$raw_message" | sed -E \
    -e 's/<\/?think>.*//g' \
    -e 's/^[Cc]ommit [Mm]essage:?\s*//' \
    -e 's/;.*//' \
    -e 's/^[`"'\''\s]+//' \
    -e 's/[`"'\''\s\.]+$//' \
    -e 's/^[[:space:]]+//; s/[[:space:]]+$//' \
    | grep -v '^$' | head -n 1)

if [[ -n "$message" ]]; then
    word_count=$(echo "$message" | wc -w)
    if [[ $word_count -gt 7 ]]; then
        message=$(echo "$message" | cut -d' ' -f1-7)
    fi
fi

if [[ -z "$message" ]]; then
    message="Update staged files"
else
    first_char=$(echo "${message:0:1}" | tr '[:lower:]' '[:upper:]')
    message="${first_char}${message:1}"
fi

echo -e "\nAI-Commit (Edit inline with arrows/backspace, then press Enter):"

read -e -i "$message" -p "Commit message: " user_message

if [[ -z "$user_message" ]]; then
    echo "❌ Error: Commit message cannot be empty. Aborting." >&2
    exit 1
fi

git commit -m "$user_message"
