#!/usr/bin/env bash

# 1. Dynamically query the currently active workspace ID
CURRENT_WS=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id' 2>/dev/null)

if [[ -z "$CURRENT_WS" || "$CURRENT_WS" == "null" ]]; then
    CURRENT_WS=1
fi

TARGET_DIR="$HOME/.config/local-ai"

# --- 1. Lazygit (Left) ---
if hyprctl clients -j 2>/dev/null | jq -e '.[] | select(.class == "lazygit")' >/dev/null 2>&1; then
    # Pull existing window to active workspace
    hyprctl dispatch movetoworkspace "${CURRENT_WS},class:^(lazygit)$" >/dev/null 2>&1
else
    # Launch Kitty with lazygit directly
    kitty --class lazygit --directory "$TARGET_DIR" lazygit &
    sleep 0.25
fi

# --- 2. Kitty Terminal (Right) ---
if hyprctl clients -j 2>/dev/null | jq -e '.[] | select(.class == "local-ai-terminal")' >/dev/null 2>&1; then
    # Pull existing terminal to active workspace
    hyprctl dispatch movetoworkspace "${CURRENT_WS},class:^(local-ai-terminal)$" >/dev/null 2>&1
else
    # Launch interactive terminal directly
    kitty --class local-ai-terminal --directory "$TARGET_DIR" --title '~/.config/local-ai' bash -i -c 'cd "'"$TARGET_DIR"'"; if read -e -p "${PS1@P}" -i "ai-commit"; then history -s "$REPLY"; history -a; eval "$REPLY"; fi; exec bash' &
fi

echo "Workspace reset complete: State --GitCom (Active WS: ${CURRENT_WS})"
